MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
NEXCONTROL_DB_NAME=nexcontrol
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-a-random-long-secret
NEXCONTROL_FLEET_KEY=replace-with-a-random-fleet-key
# Optional dedicated Agent key. If omitted, the Agent can reuse NEXCONTROL_FLEET_KEY.
NEXCONTROL_AGENT_KEY=replace-with-a-random-agent-key
