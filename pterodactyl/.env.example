# Public Pterodactyl allocation
PORT=10000

# Public HTTPS URL mapped to PORT.
# No trailing slash.
NEXUS_PUBLIC_BASE_URL=https://bot.example.com

# Internal-only ports. Do not expose these allocations publicly.
NEXUS_TELEGRAM_INTERNAL_PORT=10001
NEXMETA_INTERNAL_PORT=10002

# Shared Nexus data
NEXUS_MONGODB_URI=
NEXMETA_DB_NAME=nexmeta

# Meta App / Messenger
# Use the Graph API version configured for the Meta App.
NEXMETA_GRAPH_VERSION=
NEXMETA_APP_ID=
NEXMETA_APP_SECRET=

# Random secret Meta uses only for webhook verification.
NEXMETA_VERIFY_TOKEN=

# 32-byte AES key encoded as 64 hex chars or Base64.
NEXMETA_TOKEN_ENCRYPTION_KEY=

# Owner connection page: https://bot.example.com/connect/meta
# Separate from Facebook password. Choose a long random value.
NEXMETA_CONNECT_KEY=

# NexControl -> NexMeta privileged machine API.
NEXMETA_CONTROL_KEY=

# Optional persistent internal bridge key.
# If omitted, Pterodactyl generates an ephemeral bridge key each boot.
# Set it for stable media-relay URLs across process restarts.
NEXUS_COMMAND_GATEWAY_KEY=

# Required bridge services before bridgeReady becomes true.
NEXMETA_REQUIRED_NEXUS_SERVICES=nexdownloader,nexgame,nexstick,nexgroup,nexcanal

# Adapter/runtime paths
NEXUS_ROOT=/home/container
NEXUS_ADAPTER_DIR=/home/container/nexus-bridge/adapters
NEXUS_BRIDGE_DEDUP_TTL_MS=600000

# NexDownloader direct-provider bridge
NEXUS_BRIDGE_TIKWM_DISABLED=false
NEXUS_BRIDGE_TIKWM_TASK_DISABLED=false
NEXUS_BRIDGE_COBALT_ENABLED=false
NEXUS_BRIDGE_WEB_METADATA_DISABLED=false

# NEXMETA_OAUTH_REDIRECT_URI is optional.
# When omitted, it is derived automatically from NEXUS_PUBLIC_BASE_URL:
# https://bot.example.com/oauth/meta/callback
