[Unit]
Description=NexGuard to NexForge shared AI repair bridge
After=network-online.target nexguard.service nex-automation-supervisor.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nex/apps/internal/nexguard/current
Environment=NEX_ROOT=/opt/nex/current
Environment=NEXGUARD_RUNTIME=/var/lib/nex/runtime/nexguard
Environment=NEX_AUTOMATION_RUNTIME=/var/lib/nex/runtime/automation-supervisor
Environment=NEXFORGE_REPAIR_BRIDGE_RUNTIME=/var/lib/nex/runtime/nexforge-repair-bridge
EnvironmentFile=-/etc/nexforge-host-agent.env
EnvironmentFile=-/etc/nex/secrets/legacy-root.env
EnvironmentFile=-/etc/nex/nexguard-ai.env
ExecStart=/usr/bin/node /opt/nex/apps/internal/nexguard/current/nexforge-repair-bridge.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
