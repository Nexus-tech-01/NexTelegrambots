[Unit]
Description=Nexus strict cross-platform automation supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nex/current
Environment=NEX_ROOT=/opt/nex/current
EnvironmentFile=-/etc/nex/nexautomation.env
ExecStart=/usr/bin/node /opt/nex/current/nexcontrol/guard/automation-supervisor.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
