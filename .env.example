# Nexus Telegram Bots — shared deployment environment
# Copy only for local use. On Render, fill the sync:false variables in the dashboard.

# Shared MongoDB
NEXUS_MONGODB_URI=
NEXUS_MONGODB_DB_NAME=nexus_bots

# Optional override. On Render this is derived automatically from RENDER_EXTERNAL_HOSTNAME.
NEXUS_PUBLIC_BASE_URL=

# Cross-promotion
NEXUS_CROSS_PROMO_ENABLED=true
NEXUS_CROSS_PROMO_MIN_USES=6
NEXUS_CROSS_PROMO_COOLDOWN_DAYS=5

# NexGame — @TheNexGame_bot
NEXGAME__BOT_TOKEN=
NEXGAME__REDIS_URL=
NEXGAME__WEBHOOK_SECRET=
NEXGAME__PAYMENT_SIGNING_SECRET=
NEXGAME__INTERNAL_OWNER_IDS=

# NexCanal Manager — @the_big_dipper_bot
NEXCANAL__BOT_TOKEN=
NEXCANAL__WEBHOOK_SECRET=
NEXCANAL__NEXCANAL_INTERNAL_ADMIN_IDS=

# NexCanal Channel Watcher — @liteapks -> @thenexusorigin
NEXCANAL__WATCHER_SOURCE=liteapks
NEXCANAL__WATCHER_DESTINATION=thenexusorigin
NEXCANAL__WATCHER_API_ID=
NEXCANAL__WATCHER_API_HASH=
NEXCANAL__WATCHER_SESSION=
NEXCANAL__WATCHER_POLL_MS=15000

# NexDownloader — @TheNexDownloader_bot
NEXDOWNLOADER__BOT_TOKEN=
NEXDOWNLOADER__OWNER_TELEGRAM_ID=

# NexGroup Manager — @DarkNexus01_bot
NEXGROUP__TELEGRAM_BOT_TOKEN=
NEXGROUP__TELEGRAM_WEBHOOK_SECRET=
NEXGROUP__TELEGRAM_API_ID=
NEXGROUP__TELEGRAM_API_HASH=
NEXGROUP__NEXGROUP_OWNER_ID=

# NexStick — @The_Nexus_techbot
NEXSTICK__BOT_TOKEN=
NEXSTICK__ADMIN_IDS=
