# Nexus Telegram Bots + NexMeta — shared Pterodactyl environment
# Copy only for local use. Store production secrets in Pterodactyl variables.

# Shared MongoDB
NEXUS_MONGODB_URI=
NEXUS_MONGODB_DB_NAME=nexus_bots

# Public HTTPS URL mapped to the Pterodactyl public allocation.
NEXUS_PUBLIC_BASE_URL=

# Unified Pterodactyl internal ports
NEXUS_TELEGRAM_INTERNAL_PORT=10001
NEXMETA_INTERNAL_PORT=10002

# NexMeta -> Nexus internal command bridge
# Never commit the real value.
NEXUS_COMMAND_GATEWAY_KEY=
NEXUS_BRIDGE_DEDUP_TTL_MS=600000
NEXUS_ADAPTER_DIR=/home/container/nexus-bridge/adapters
NEXMETA_REQUIRED_NEXUS_SERVICES=nexdownloader,nexgame,nexstick,nexgroup,nexcanal,nexwhisper,nexai

# NexAI on Facebook/Messenger — OpenAI-compatible provider
NEXAI_API_URL=
NEXAI_API_KEY=
NEXAI_MODEL=
NEXAI_SYSTEM_PROMPT=
NEXAI_MAX_TOKENS=1200
NEXAI_TIMEOUT_MS=25000
NEXAI_TEMPERATURE=0.7

# NexWhisper Messenger anti-spam cooldown
NEXWHISPER_COOLDOWN_MS=3000

# Cross-promotion
NEXUS_CROSS_PROMO_ENABLED=true
NEXUS_CROSS_PROMO_MIN_USES=6
NEXUS_CROSS_PROMO_COOLDOWN_DAYS=5

# NexGame — @TheNexGame_bot
NEXGAME__BOT_TOKEN=
NEXGAME__REDIS_URL=
NEXGAME__WEBHOOK_SECRET=
NEXGAME__PAYMENT_SIGNING_SECRET=
NEXGAME__INTERNAL_OWNER_IDS=

# NexCanal Manager — @the_big_dipper_bot
NEXCANAL__BOT_TOKEN=
NEXCANAL__WEBHOOK_SECRET=
NEXCANAL__NEXCANAL_INTERNAL_ADMIN_IDS=

# NexDownloader — @TheNexDownloader_bot
NEXDOWNLOADER__BOT_TOKEN=
NEXDOWNLOADER__OWNER_TELEGRAM_ID=

# NexGroup Manager — @DarkNexus01_bot
NEXGROUP__TELEGRAM_BOT_TOKEN=
NEXGROUP__TELEGRAM_WEBHOOK_SECRET=
NEXGROUP__TELEGRAM_API_ID=
NEXGROUP__TELEGRAM_API_HASH=
NEXGROUP__NEXGROUP_OWNER_ID=

# NexStick — @The_Nexus_techbot
NEXSTICK__BOT_TOKEN=
NEXSTICK__ADMIN_IDS=
