# Nexus Telegram Bots — shared deployment environment
# Copy only for local use. On the server, keep real secrets in the environment.

# Shared MongoDB
NEXUS_MONGODB_URI=
NEXUS_MONGODB_DB_NAME=nexus_bots

# Optional public base URL
NEXUS_PUBLIC_BASE_URL=

# Cross-promotion
NEXUS_CROSS_PROMO_ENABLED=true
NEXUS_CROSS_PROMO_MIN_USES=6
NEXUS_CROSS_PROMO_COOLDOWN_DAYS=5

# NexGame — @TheNexGame_bot
NEXGAME__BOT_TOKEN=
NEXGAME__REDIS_URL=
NEXGAME__WEBHOOK_SECRET=
NEXGAME__PAYMENT_SIGNING_SECRET=
NEXGAME__INTERNAL_OWNER_IDS=

# NexCanal Manager — @the_big_dipper_bot
NEXCANAL__BOT_TOKEN=
NEXCANAL__WEBHOOK_SECRET=
NEXCANAL__NEXCANAL_INTERNAL_ADMIN_IDS=

# NexCanal channel topology — all public posts are sent by NexCanal
NEXCANAL__LIFESTYLE_DESTINATION=tresor_universe
NEXCANAL__APK_DESTINATION=thenexusorigin
NEXCANAL__ANIME_DESTINATION=theotaku_nexus
NEXCANAL__NEWS_DESTINATION=thenexnews

# Visual lifestyle feed — Luxury Life / Otaku / Mood / Phrase du jour
# Every post is media-first: if no usable image is found, the publication is skipped and retried.
NEXSOCIAL__ENABLED=true
NEXSOCIAL__DESTINATION=tresor_universe
NEXSOCIAL__TIMEZONE=Africa/Porto-Novo
NEXSOCIAL__ACTIVE_START_HOUR=7
NEXSOCIAL__ACTIVE_END_HOUR=23
NEXSOCIAL__MIN_INTERVAL_MS=2700000
NEXSOCIAL__MAX_INTERVAL_MS=4500000

# APK scanner — only @tresor20009 reads LiteAPK/iMadeaux
NEXCANAL__WATCHER_SOURCE=liteapks
NEXCANAL__WATCHER_DESTINATION=thenexusorigin
NEXCANAL__WATCHER_EXPECTED_USERNAME=tresor20009
NEXCANAL__WATCHER_API_ID=
NEXCANAL__WATCHER_API_HASH=
NEXCANAL__WATCHER_SESSION=
NEXCANAL__WATCHER_POLL_MS=15000
# Public pacing: keep scanning continuously, but send one unrelated publication batch every 2 hours.
# A linked descriptor (image/caption) + APK bypasses the gap between its own two parts.
NEXCANAL__WATCHER_PUBLICATION_GAP_MS=7200000
NEXCANAL__WATCHER_LINK_WINDOW_MS=1800000
NEXCANAL__WATCHER_WORKERS=1

# NexAnime intelligent ingestion — source accounts -> NexCanal -> @theotaku_nexus
NEXANIME__ENABLED=true
NEXANIME__DESTINATION=theotaku_nexus
# Falls back to NEXCANAL__WATCHER_API_ID/HASH or NEXGROUP__TELEGRAM_API_ID/HASH.
NEXANIME__API_ID=
NEXANIME__API_HASH=
# Authorized source-account sessions. The worker verifies the real Telegram username
# and refuses sessions outside @tresor20001 / @tresor20009 by default.
NEXANIME__SESSION_TRESOR20001=
NEXANIME__SESSION_TRESOR20009=
NEXANIME__ALLOWED_ACCOUNTS=tresor20001,tresor20009
# Optional dedicated token; when empty NEXCANAL__BOT_TOKEN is used.
NEXANIME__NEXCANAL_BOT_TOKEN=
# Automatic source discovery. Leave allowlist empty to classify joined broadcast channels.
NEXANIME__SOURCE_ALLOWLIST=
NEXANIME__SOURCE_DENYLIST=
NEXANIME__DISCOVERY_SAMPLE=24
NEXANIME__DISCOVERY_CHANNEL_LIMIT=120
NEXANIME__DISCOVERY_MS=21600000
# First-connection historical recovery for currently airing anime.
NEXANIME__BACKFILL_MESSAGES=900
NEXANIME__ACTIVE_DAYS=45
# Live queue and resource controls.
NEXANIME__POLL_MS=15000
NEXANIME__PUBLISH_GAP_MS=8000
NEXANIME__MAX_TMP_BYTES=2306867200
NEXANIME__STATE_FILE=/var/data/nexanime-state.json
NEXANIME__TMP_DIR=/var/data/nexanime-tmp
NEXANIME__ANILIST_ENABLED=true


# NexAnime ingestion -> @theotaku_nexus
# Uses the already-paired NexAccount MTProto sessions; no extra Telegram login is stored here.
NEXANIME_ENABLED=true
NEXANIME_LISTENER_USERNAMES=tresor20001,tresor20009
NEXANIME_SECONDARY_EXPECTED_USERNAME=tresor20009
NEXANIME_DESTINATION=theotaku_nexus
NEXANIME_DIALOG_LIMIT=120
NEXANIME_SOURCE_SAMPLE_LIMIT=40
NEXANIME_ACTIVE_SAMPLE_LIMIT=80
NEXANIME_MAX_ACTIVE_SERIES=8
NEXANIME_MAX_SELECTED_SOURCES=10
NEXANIME_BACKFILL_LIMIT=3000
NEXANIME_DISCOVERY_MS=21600000
NEXANIME_PUBLISH_MS=900000
# Wait only between two different anime batches (15 minutes).
NEXANIME_INTER_SERIES_MS=900000
NEXANIME_POLL_MS=60000
NEXANIME_TMP_DIR=/var/data/nexanime-tmp
NEXANIME_SECONDARY_SESSION_FILE=/home/container/.nexcontrol/nexcanal-reader-session.txt
# Episode media is queued but not reuploaded unless the operator confirms the
# source is authorized/licensed for redistribution.
NEXANIME_MEDIA_POLICY=authorized_only

# NexDownloader — @TheNexDownloader_bot
NEXDOWNLOADER__BOT_TOKEN=
NEXDOWNLOADER__OWNER_TELEGRAM_ID=

# NexGroup Manager — @DarkNexus01_bot
NEXGROUP__TELEGRAM_BOT_TOKEN=
NEXGROUP__TELEGRAM_WEBHOOK_SECRET=
NEXGROUP__TELEGRAM_API_ID=
NEXGROUP__TELEGRAM_API_HASH=
NEXGROUP__NEXGROUP_OWNER_ID=

# NexStick — @The_Nexus_techbot
NEXSTICK__BOT_TOKEN=
NEXSTICK__ADMIN_IDS=
