{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "nexai-connect",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
