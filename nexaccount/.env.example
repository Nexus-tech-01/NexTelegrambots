# Telegram MTProto application credentials (my.telegram.org)
NEXACCOUNT_TELEGRAM_API_ID=
NEXACCOUNT_TELEGRAM_API_HASH=

# Normal Telegram bot used for Inline Mode / callbacks.
# Enable Inline Mode for this bot in BotFather.
NEXAI_BOT_TOKEN=
NEXAI_BOT_USERNAME=

# Shared Nexus MongoDB (sessions are AES-256-GCM encrypted before storage)
NEXUS_MONGODB_URI=
NEXACCOUNT_DB_NAME=nexus_bots

# Dedicated secret strongly recommended.
# Fallbacks: NEXCONTROL_SESSION_SECRET / SESSION_SECRET / NEXCONTROL_FLEET_KEY
NEXACCOUNT_SESSION_KEY=

NEXAI_OWNER_NAME=Trésor
NEXAI_DEFAULT_STYLE=1
NEXAI_NEXTECH_URL=https://t.me/thenexusorigin
NEXAI_NEXNEWS_URL=https://t.me/thenexnews
NEXAI_DARK_UNIVERSE_URL=

# Optional Telegram custom emoji document IDs used on inline buttons
NEXAI_EMOJI_GENERAL=
NEXAI_EMOJI_AI=
NEXAI_EMOJI_DOWNLOAD=
NEXAI_EMOJI_GROUP=
NEXAI_EMOJI_CHANNEL=
NEXAI_EMOJI_TOOLS=
NEXAI_EMOJI_STICKER=
NEXAI_EMOJI_GAMES=
NEXAI_EMOJI_SHIELD=
NEXAI_EMOJI_ANIME=
NEXAI_EMOJI_SEARCH=
NEXAI_EMOJI_PREMIUM=
NEXAI_EMOJI_OWNER=
NEXAI_EMOJI_NEXTECH=
NEXAI_EMOJI_NEWS=
NEXAI_EMOJI_DARK=
NEXAI_EMOJI_BACK=


# NexAI execution adapters. Username overrides are optional when the matching
# bot token already exists in the shared server environment: NexAI resolves
# the bot username with getMe without exposing the token.
NEXAI_NEXDOWNLOADER_BOT_USERNAME=
NEXAI_NEXGROUP_BOT_USERNAME=
NEXAI_NEXGAME_BOT_USERNAME=
NEXAI_NEXSTICK_BOT_USERNAME=
NEXAI_NEXWHISPER_BOT_USERNAME=
NEXAI_DIPPER_BOT_USERNAME=the_big_dipper_bot
DIPPER_TELEGRAM_BOT_TOKEN=
