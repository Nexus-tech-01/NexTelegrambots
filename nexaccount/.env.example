# Telegram MTProto application credentials (my.telegram.org)
NEXACCOUNT_TELEGRAM_API_ID=
NEXACCOUNT_TELEGRAM_API_HASH=

# Normal Telegram bot used for Inline Mode / callbacks.
# Enable Inline Mode for this bot in BotFather.
NEXAI_BOT_TOKEN=
NEXAI_BOT_USERNAME=

# Shared Nexus MongoDB (sessions are AES-256-GCM encrypted before storage)
NEXUS_MONGODB_URI=
NEXACCOUNT_DB_NAME=nexus_bots

# Dedicated secret strongly recommended.
# Fallbacks: NEXCONTROL_SESSION_SECRET / SESSION_SECRET / NEXCONTROL_FLEET_KEY
NEXACCOUNT_SESSION_KEY=

NEXAI_OWNER_NAME=Trésor
NEXAI_DEFAULT_STYLE=1
NEXAI_NEXTECH_URL=https://t.me/thenexusorigin
NEXAI_NEXNEWS_URL=https://t.me/thenexnews
NEXAI_DARK_UNIVERSE_URL=

# Official NexAI command documentation channel.
# One French and one English Telegram post are maintained per canonical command.
NEXAI_HELP_CHANNEL_USERNAME=Nextech_NexAi
NEXAI_HELP_AUTO_SYNC=true
NEXAI_HELP_SYNC_DELAY_MS=250

# Native AI engine. NexAi no longer routes AI requests through Stacy.
# Recommended: point this to any OpenAI-compatible local/private endpoint.
NEXAI_LLM_BASE_URL=
NEXAI_LLM_API_KEY=
NEXAI_LLM_MODEL=
NEXAI_CODE_MODEL=
NEXAI_DEEPSEEK_MODEL=
# Optional provider fallbacks. Configure only providers you use.
GEMINI_API_KEY=
NEXAI_GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NEXAI_AI_MAX_TOKENS=1400
NEXAI_AI_TIMEOUT_MS=45000
NEXAI_AI_HISTORY_MESSAGES=14
NEXAI_AI_HISTORY_TTL_MS=7200000

# Local media/sticker conversion. Same server binary used by NexAi audio tools.
FFMPEG_PATH=ffmpeg
NEXAI_STICKER_MAX_SOURCE_BYTES=26214400
NEXAI_STICKER_CLONE_LIMIT=50
NEXAI_STICKER_EXPORT_LIMIT=50

# Optional Telegram custom emoji document IDs used on inline buttons
NEXAI_EMOJI_GENERAL=
NEXAI_EMOJI_ACCOUNT=
NEXAI_EMOJI_AI=
NEXAI_EMOJI_DOWNLOAD=
NEXAI_EMOJI_GROUP=
NEXAI_EMOJI_CHANNEL=
NEXAI_EMOJI_TOOLS=
NEXAI_EMOJI_MEDIA=
NEXAI_EMOJI_STICKER=
NEXAI_EMOJI_GAMES=
NEXAI_EMOJI_SHIELD=
NEXAI_EMOJI_ANIME=
NEXAI_EMOJI_SEARCH=
NEXAI_EMOJI_PREMIUM=
NEXAI_EMOJI_OWNER=
NEXAI_EMOJI_NEXTECH=
NEXAI_EMOJI_NEWS=
NEXAI_EMOJI_DARK=
NEXAI_EMOJI_BACK=
NEXAI_EMOJI_NEXT=
NEXAI_EMOJI_STYLE=

# Optional style-specific custom emoji IDs used inside quoted headers.
# Missing/invalid IDs automatically fall back to the Unicode emoji in the theme.
NEXAI_EMOJI_STYLE_1=
NEXAI_EMOJI_STYLE_2=
NEXAI_EMOJI_STYLE_3=
NEXAI_EMOJI_STYLE_4=
NEXAI_EMOJI_STYLE_5=
NEXAI_EMOJI_STYLE_6=
NEXAI_EMOJI_STYLE_7=
NEXAI_EMOJI_STYLE_8=
NEXAI_EMOJI_STYLE_9=
NEXAI_EMOJI_STYLE_10=
NEXAI_EMOJI_STYLE_11=
NEXAI_EMOJI_STYLE_12=
NEXAI_EMOJI_STYLE_13=
NEXAI_EMOJI_STYLE_14=
NEXAI_EMOJI_STYLE_15=
NEXAI_EMOJI_STYLE_16=
NEXAI_EMOJI_STYLE_17=
NEXAI_EMOJI_STYLE_18=
NEXAI_EMOJI_STYLE_19=
NEXAI_EMOJI_STYLE_20=
NEXAI_EMOJI_STYLE_21=
NEXAI_EMOJI_STYLE_22=
NEXAI_EMOJI_STYLE_23=
NEXAI_EMOJI_STYLE_24=
NEXAI_EMOJI_STYLE_25=
NEXAI_EMOJI_STYLE_26=
NEXAI_EMOJI_STYLE_27=
NEXAI_EMOJI_STYLE_28=
NEXAI_EMOJI_STYLE_29=
NEXAI_EMOJI_STYLE_30=
NEXAI_EMOJI_STYLE_31=

# Optional per-style artwork override(s). Multiple URLs can be separated with |.
# Every style 1–31 can be overridden; character styles also have automatic AniList fallbacks when no valid URL is configured.
NEXAI_STYLE_1_IMAGE_URLS=
NEXAI_STYLE_2_IMAGE_URLS=
NEXAI_STYLE_3_IMAGE_URLS=
NEXAI_STYLE_4_IMAGE_URLS=
NEXAI_STYLE_5_IMAGE_URLS=
NEXAI_STYLE_6_IMAGE_URLS=
NEXAI_STYLE_7_IMAGE_URLS=
NEXAI_STYLE_8_IMAGE_URLS=
NEXAI_STYLE_9_IMAGE_URLS=
NEXAI_STYLE_10_IMAGE_URLS=
NEXAI_STYLE_11_IMAGE_URLS=
NEXAI_STYLE_12_IMAGE_URLS=
NEXAI_STYLE_13_IMAGE_URLS=
NEXAI_STYLE_14_IMAGE_URLS=
NEXAI_STYLE_15_IMAGE_URLS=
NEXAI_STYLE_16_IMAGE_URLS=
NEXAI_STYLE_17_IMAGE_URLS=
NEXAI_STYLE_18_IMAGE_URLS=
NEXAI_STYLE_19_IMAGE_URLS=
NEXAI_STYLE_20_IMAGE_URLS=
NEXAI_STYLE_21_IMAGE_URLS=
NEXAI_STYLE_22_IMAGE_URLS=
NEXAI_STYLE_23_IMAGE_URLS=
NEXAI_STYLE_24_IMAGE_URLS=
NEXAI_STYLE_25_IMAGE_URLS=
NEXAI_STYLE_26_IMAGE_URLS=
NEXAI_STYLE_27_IMAGE_URLS=
NEXAI_STYLE_28_IMAGE_URLS=
NEXAI_STYLE_29_IMAGE_URLS=
NEXAI_STYLE_30_IMAGE_URLS=
NEXAI_STYLE_31_IMAGE_URLS=

# Internal NexAccount control API authentication.
# If omitted, NexAccount falls back to NEXCONTROL_FLEET_KEY / session secret.
NEXACCOUNT_CONTROL_KEY=

# Horizontal session workers.
# Worker 0 is the coordinator (NexAI bot polling + pairing gateway).
# All workers must share the same WORKER_COUNT and use a unique WORKER_INDEX.
NEXACCOUNT_WORKER_COUNT=1
NEXACCOUNT_WORKER_INDEX=0
NEXACCOUNT_WORKER_ID=
NEXACCOUNT_MAX_RUNTIMES_PER_WORKER=1000
NEXACCOUNT_RESTORE_CONCURRENCY=10
NEXACCOUNT_RUNTIME_LEASE_MS=120000
NEXACCOUNT_RECONCILE_MS=30000
NEXACCOUNT_COMMAND_POLL_MS=10000
NEXACCOUNT_UPDATE_SYNC_MS=20000

# Optional explicit local control port.
# Without this, worker 0 uses 3491, worker 1 uses 3492, etc.
NEXACCOUNT_PORT=

# Optional: only enable a special Anime publishing account when explicitly configured.
NEXANIME_PRIMARY_PUBLISHER_ENABLED=false
NEXANIME_PRIMARY_PUBLISHER_USERNAME=

# NexAnime on-demand bot — @NexAnime01_bot
NEXANIME_BOT_USERNAME=NexAnime01_bot
NEXANIME_BOT_TOKEN=
NEXANIME_FRANIME_API=https://api.franime.fr
NEXANIME_FRANIME_SITE=https://franime.fr
NEXANIME_DOWNLOAD_CONCURRENCY=2
NEXANIME_DOWNLOAD_DIR=/var/data/nexanime-bot-downloads
NEXANIME_BIN_DIR=/var/data/nexanime-bot-bin
