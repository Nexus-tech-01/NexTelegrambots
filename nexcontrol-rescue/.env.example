# Copy to .env on the VPS only, set chmod 600, never commit actual values.
MONGO_USER=nexcontrolrescue
MONGO_PASSWORD=replace-with-long-alphanumeric-mongo-password
ADMIN_PASSWORD=replace-with-long-unique-admin-password
SESSION_SECRET=replace-with-64-random-characters
# Must match the credentials already used by the existing NexControl agents/bots.
# Never rotate both endpoints in the middle of migration without a rollback plan.
NEXCONTROL_FLEET_KEY=copy-existing-secret-from-authorized-vps-env
NEXCONTROL_AGENT_KEY=copy-existing-agent-secret-from-authorized-vps-env
