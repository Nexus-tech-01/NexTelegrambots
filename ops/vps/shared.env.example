# Copy to /etc/nex/env/shared.env and keep mode 0640 or stricter.
# Do not commit real credentials.

# Shared MongoDB used by Nexus services that explicitly consume this variable.
NEXUS_MONGODB_URI=

# Public base URL only after a reverse proxy/TLS endpoint exists.
NEXUS_PUBLIC_BASE_URL=

# Add shared Redis variables only after verifying the exact variable names
# consumed by each bot. Do not invent aliases during migration.
