# Copy to /etc/nex/env/nexaccount.env and keep mode 0640 or stricter.
# Do not commit real values.

# Telegram MTProto application credentials
NEXACCOUNT_TELEGRAM_API_ID=
NEXACCOUNT_TELEGRAM_API_HASH=

# NexAI Bot API identity
NEXAI_BOT_TOKEN=
NEXAI_BOT_USERNAME=

# MongoDB is normally supplied by /etc/nex/env/shared.env.
# Set it here only if you deliberately keep NexAccount isolated.
# NEXUS_MONGODB_URI=
NEXACCOUNT_DB_NAME=nexus_bots

# Encrypts Telegram MTProto session strings before MongoDB storage.
NEXACCOUNT_SESSION_KEY=
NEXACCOUNT_CONTROL_KEY=

# Mutable runtime state must stay outside /opt/nex/current.
NEXACCOUNT_RUNTIME_DIR=/var/lib/nex/runtime/nexaccount

# Worker topology. Every active worker must use this same count.
# The instance unit nexaccount@N.service supplies NEXACCOUNT_WORKER_INDEX=N.
NEXACCOUNT_WORKER_COUNT=1
NEXACCOUNT_MAX_RUNTIMES_PER_WORKER=1000
NEXACCOUNT_RESTORE_CONCURRENCY=10
NEXACCOUNT_RUNTIME_LEASE_MS=120000
NEXACCOUNT_RECONCILE_MS=30000
NEXACCOUNT_COMMAND_POLL_MS=10000
NEXACCOUNT_UPDATE_SYNC_MS=20000

# Local-only control interface. Leave NEXACCOUNT_PORT unset so each worker uses
# 3491 + worker index.
NEXACCOUNT_HOST=127.0.0.1

# Persistent/file-backed scanner state
NEXANIME_SECONDARY_SESSION_FILE=/var/lib/nex/sessions/nexcanal-reader-session.txt
NEXCANAL__WATCHER_ID_FILE=/var/lib/nex/sessions/nexcanal-watcher-id.txt
NEXANIME_TMP_DIR=/var/lib/nex/downloads/nexanime-tmp

# Current NexAnime behavior
NEXANIME_ENABLED=true
NEXANIME_LISTENER_USERNAMES=tresor20001,tresor20009
NEXANIME_DESTINATION=theotaku_nexus
NEXANIME_MEDIA_POLICY=authorized_only
NEXANIME_PUBLISH_MS=15000
NEXANIME_INTER_SERIES_MS=900000

# Media tools
FFMPEG_PATH=ffmpeg

# Optional AI providers. Configure only providers actually used.
NEXAI_LLM_BASE_URL=
NEXAI_LLM_API_KEY=
NEXAI_LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
