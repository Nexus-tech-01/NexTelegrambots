# Copy to /etc/nex/env/backup.env, mode 0600 or 0640.
# No real destination credentials belong in Git.

# Required. Examples:
#   /mnt/offsite/nex-backups
#   backup-user@backup-host:/srv/nex-backups
NEX_BACKUP_TARGET=

# File containing one or more public age recipients.
# Keep the corresponding private age identity OFF this VPS.
NEX_BACKUP_RECIPIENT_FILE=/etc/nex/secrets/backup-age-recipients.txt

# Encrypted local staging only; copies are pushed to NEX_BACKUP_TARGET.
NEX_BACKUP_STAGING_DIR=/backups/nex/staging
NEX_BACKUP_LOCAL_KEEP=7
