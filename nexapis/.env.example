PORT=8787

# OpenAI-compatible text provider
NEXAPIS_AI_BASE_URL=
NEXAPIS_AI_API_KEY=
NEXAPIS_AI_MODEL=gpt-4.1-mini

# OpenAI-compatible image provider (falls back to AI base/key)
NEXAPIS_IMAGE_BASE_URL=
NEXAPIS_IMAGE_API_KEY=
NEXAPIS_IMAGE_MODEL=gpt-image-1

# Optional local binary
YTDLP_BIN=yt-dlp

# Stateless URL signing
NEXAPIS_SHORT_SECRET=change-me

# Optional provider overrides. Pattern:
# NEXAPIS_PROVIDER_<ROUTE_WITH_NON_ALNUM_AS_UNDERSCORES>=https://your-provider.example/endpoint
# Example: /removebg -> NEXAPIS_PROVIDER_REMOVEBG
# NEXAPIS_PROVIDER_REMOVEBG=
