# NexMeta runs inside the shared Pterodactyl runtime.
# Prefer pterodactyl/.env.example for production.

PORT=10002
NEXUS_PUBLIC_BASE_URL=https://bot.example.com

NEXUS_MONGODB_URI=
NEXMETA_DB_NAME=nexmeta

# Meta application
NEXMETA_GRAPH_VERSION=
NEXMETA_APP_ID=
NEXMETA_APP_SECRET=
NEXMETA_VERIFY_TOKEN=

# Optional explicit override.
# By default this is derived from NEXUS_PUBLIC_BASE_URL.
NEXMETA_OAUTH_REDIRECT_URI=

# 32 random bytes encoded as base64 or 64 hex characters.
NEXMETA_TOKEN_ENCRYPTION_KEY=

# Owner-only direct connection page
NEXMETA_CONNECT_KEY=

# NexControl -> NexMeta machine control
NEXMETA_CONTROL_KEY=

# Optional static Page fallback. OAuth is preferred.
NEXMETA_PAGE_ID=
NEXMETA_PAGE_ACCESS_TOKEN=

# The Pterodactyl supervisor injects these automatically for NexMeta.
NEXUS_COMMAND_GATEWAY_URL=
NEXUS_COMMAND_GATEWAY_KEY=

# Bridge READY requires all of these adapters.
NEXMETA_REQUIRED_NEXUS_SERVICES=nexdownloader,nexgame,nexstick,nexgroup,nexcanal


# Dedicated-systemd mode (recommended on the primary VPS)
# All NexMeta workers share one persistent Chromium profile through CDP.
NEXMETA_BROWSER_DEBUG_URL=http://127.0.0.1:9223
NEXMETA_PERSONAL_BROWSER_URL=http://127.0.0.1:9223

# Disable the in-process personal watcher when nexmeta-personal-worker.service
# runs as its own supervised worker. This prevents duplicate navigation/replies.
NEXMETA_PERSONAL_WATCHER=0
