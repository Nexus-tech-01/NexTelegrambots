PORT=8788
NEXMETA_PUBLIC_BASE_URL=
NEXUS_MONGODB_URI=
NEXMETA_DB_NAME=nexmeta

# Meta application
NEXMETA_GRAPH_VERSION=
NEXMETA_APP_ID=
NEXMETA_APP_SECRET=
NEXMETA_VERIFY_TOKEN=

# Preferred production connection flow
NEXMETA_OAUTH_REDIRECT_URI=https://nexmeta.example.com/oauth/meta/callback
# 32 random bytes encoded as base64 or 64 hex characters.
NEXMETA_TOKEN_ENCRYPTION_KEY=

# Optional static Page fallback for initial/bootstrap deployments
NEXMETA_PAGE_ID=
NEXMETA_PAGE_ACCESS_TOKEN=

# NexControl -> NexMeta machine control
NEXMETA_CONTROL_KEY=

# Optional common Nexus command gateway
NEXUS_COMMAND_GATEWAY_URL=
NEXUS_COMMAND_GATEWAY_KEY=
# Bridge READY requires all of these adapters by default.
NEXMETA_REQUIRED_NEXUS_SERVICES=nexdownloader,nexgame,nexstick,nexgroup,nexcanal
